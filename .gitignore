# iosApp/iosApp/ (the conventional Xcode target-resource location) during setup.
google-services.json
GoogleService-Info.plist

# CocoaPods (MS-683) — regenerated by `./gradlew :shared:podspec :composeApp:podspec` + `pod install`
iosApp/Pods/
iosApp/iosApp.xcworkspace/
iosApp/Podfile.lock
composeApp/composeApp.podspec
shared/shared.podspec

