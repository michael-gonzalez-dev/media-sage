default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do |options|
    supabase_host = (options[:supabase_url] || ENV['SUPABASE_URL'] || "").gsub(/https?:\/\//, "")
    supabase_anon_key = options[:supabase_anon_key] || ENV['SUPABASE_ANON_KEY'] || ""

    setup_ci if ENV['CI']

    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_filepath: ENV['APP_STORE_CONNECT_KEY_FILEPATH']
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true
    )

    increment_build_number(
      build_number: ENV['BUILD_NUMBER'] || Time.now.to_i.to_s,
      xcodeproj: "iosApp/iosApp.xcodeproj"
    )

    # Signing is scoped to the app target only. Passing it via xcargs would apply it to every target in the
    # build (e.g. Swift package targets), which cannot take a provisioning profile.
    update_code_signing_settings(
      path: "iosApp/iosApp.xcodeproj",
      targets: ["iosApp"],
      use_automatic_signing: false,
      team_id: ENV['APPLE_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.thecouragepost.app"
    )

    build_app(
      scheme: "iosApp",
      project: "iosApp/iosApp.xcodeproj",
      export_method: "app-store",
      configuration: "Release",
      export_options: {
        provisioningProfiles: { "com.thecouragepost.app" => "match AppStore com.thecouragepost.app" }
      },
      xcargs: "SUPABASE_HOST='#{supabase_host}' SUPABASE_ANON_KEY='#{supabase_anon_key}' CURRENT_PROJECT_VERSION='#{ENV['BUILD_NUMBER'] || Time.now.to_i.to_s}'"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
